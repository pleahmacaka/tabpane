// Build the start page: write the config module src/home.maca imports, then
// compile src/home.maca to build/index.html.
//
// daisyUI and iconify are not vendored here any more. The page declares them
// with `import css "…"` / `import js "…"`, so the compiler reads them at build
// time and inlines them, and index.html is the whole deployable: no build/vendor
// directory to copy and no <link> that works until the page is somewhere else.

// links.local.json is git-ignored: private links stay out of the repo
config_path() -> str {
  local = "config/links.local.json"
  file_exists(local) ? local : "config/links.json"
}

// An import names one fixed path, and which config file the page wants is not
// known until this script has looked. So the choice is made here and the answer
// written to a fixed path the page can name: `import js "links.gen.js"`. The
// channel is then a declared import and a real file rather than a string
// replace against the emitted HTML, and a build that never wrote it fails by
// naming the missing file instead of shipping a page with no links.
const generated = "src/links.gen.js"

// Written as a global because that is what the `import js` block reads; the
// asset script is emitted ahead of the app, so it is set before the first render.
write_config() {
  json = read_file(config_path())
  write_file(generated, "window.__CFG__ = {json};\n")
}

compile() -> int {
  argv = "build", "--target", "js", "src/home.maca", "-o", "build"
  code = exec("maca", argv)
  // 127 = not found: on Windows only `maca.exe` is on the shell's PATH.
  code == 127 ? exec("maca.exe", argv) : code
}

main() -> int {
  write_config()
  // No post-hoc check that the assets landed: each one is an import now, and a
  // path that resolves to no file fails the compile and names it.
  if compile() != 0 {
    fail "maca build --target js failed"
  }

  info("built build/index.html")
  0
}
