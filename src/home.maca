import css "npm:daisyui/dist/full.css"
import css "theme.css"
import js "npm:iconify-icon"

import { encode, decode } from std/json
import { local_start, local_store, local_forget } from web/storage
import { every_ms, stop_every, clock_time, clock_date } from web/time
import { download, pick_text } from web/file

Link = { title: str, url: str, icon: str }
Section = { title: str, links: Link[] }
Config = { layout: Layout, sections: Section[] }

Layout = List | Grid
Target = Fresh | Existing(int, int)
Where = End | At(int)
Spot = Nowhere | Tile(int, int) | Tail(int)
Grip = Idle | Holding(int, int)
Edit = Closed | Editing(Target)

Links = "../config/links.json"
Saved = "homepage.config"
LockKey = "homepage.locked"
Ticking = every_ms(1000)

config: Config = local_start(Saved, data(Links))
locked = local_start(LockKey, true)
note = ""
edit = Closed
form = blank()
form_section = ""

blank() -> Link => Link { title = "", url = "", icon = "lucide:link" }

commit(next: Config, said: str) {
  filled = next.sections.filter(group => group.links.length() > 0)
  config = local_store(Saved, next with { sections = filled })
  note = said
}

remove_link(from: Config, section: int, index: int) -> Config {
  group = from.sections[section]
  shorter = group with { links = group.links.remove(index) }

  from with { sections = from.sections.set(section, shorter) }
}

insert_link(into: Config, name: str, link: Link, where: Where) -> Config {
  section = into.sections.index_of_by(group => group.title == name)

  if section < 0 {
    created = Section { title = name, links = [link] }

    return into with { sections = into.sections.push(created) }
  }

  group = into.sections[section]
  at = match where {
    End => group.links.length()
    At(index) => index
  }
  longer = group with { links = group.links.insert(at, link) }

  into with { sections = into.sections.set(section, longer) }
}

toggle_lock() {
  locked = local_store(LockKey, !locked)
}

toggle_layout() {
  next = if config.layout == Grid {
    List
  } else {
    Grid
  }

  commit(config with { layout = next }, "layout: {next}")
}

sort_links() {
  sorted = config.sections.map(group =>
    group with { links = group.links.sort_by(link => link.title) })

  commit(config with { sections = sorted }, "sorted A-Z")
}

reset_config() {
  local_forget(Saved)
  config = data(Links)
  note = "reloaded {Links}"
}

export_json() {
  download("links.json", encode(config))
  note = "downloaded: move it to {Links} and rebuild"
}

import_json() {
  text = await pick_text("application/json")

  if text == "" {
    return
  }

  next: Config = decode(text)
  commit(next, "imported")
}

main() -> Element =>
  div(class="page", data-theme="night"
    div(class="mx-auto max-w-3xl flex flex-col gap-8"
      header(class="flex items-center gap-4"
        clock_face()
        div(class="flex-1")
        lock_button()
      )
      board()
      toolbar()
    )
    dialog()
  )

lock_button() -> Element {
  dim = if locked {
    "opacity-30"
  } else {
    "opacity-70"
  }

  glyph = if locked {
    "lucide:lock"
  } else {
    "lucide:lock-open"
  }

  button(class="btn btn-ghost btn-circle {dim}", onclick=toggle_lock
    iconify-icon(class="text-2xl", icon=glyph))
}

clock_face() -> Element =>
  div(class="flex flex-col"
    span(class="text-[2.6rem] leading-none font-bold tabular-nums", clock_time())
    span(class="text-xs opacity-50 mt-1", clock_date())
  )

board() -> Element {
  grip = Idle
  hovered = Nowhere

  grab(section: int, index: int) {
    if locked {
      return
    }

    grip = Holding(section, index)
  }

  hover(spot: Spot) {
    hovered = spot
  }

  release() {
    grip = Idle
    hovered = Nowhere
  }

  dropped(into: Config, link: Link, onto: Spot) -> Config =>
    match onto {
      Nowhere => into
      Tile(section, index) => insert_link(into, config.sections[section].title,
                                          link, At(index))
      Tail(section) => insert_link(into, config.sections[section].title, link, End)
    }

  drop(onto: Spot) {
    held = grip
    release()

    match held {
      Idle => return
      Holding(section, index) => {
        link = config.sections[section].links[index]
        pruned = remove_link(config, section, index)

        commit(dropped(pruned, link, onto), "moved {link.title}")
      }
    }
  }

  pencil() -> Element[] {
    if locked {
      return []
    }

    [span(class="btn btn-xs btn-circle btn-ghost ml-auto",
       iconify-icon(icon="lucide:pencil"))]
  }

  tile(link: Link, section: int, index: int) -> Element {
    lifted = if grip == Holding(section, index) {
      "opacity-30"
    } else {
      ""
    }

    marked = if hovered == Tile(section, index) {
      "ring-2 ring-primary"
    } else {
      ""
    }

    body = [
      iconify-icon(class="text-2xl shrink-0", icon=link.icon),
      span(class="text-sm font-semibold truncate", link.title)
    ] ++ pencil()

    if locked {
      return a(class="tile {lifted}", href=link.url, title=link.url, body)
    }

    div(class="tile {lifted} {marked}", title=link.url, draggable=true,
        ondragstart=grab(section, index),
        ondragover=hover(Tile(section, index)),
        ondragend=release,
        ondrop=drop(Tile(section, index)),
        onclick=open_at(section, index),
      body)
  }

  rows = if config.layout == Grid {
    "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2"
  } else {
    "flex flex-col gap-2"
  }

  div(class="flex flex-col gap-6",
    config.sections.enumerate().map(each =>
      section(class="flex flex-col gap-2",
              ondragover=hover(Tail(each.index)),
              ondrop=drop(Tail(each.index))
        h2(class="text-xs uppercase tracking-wide opacity-50 font-semibold",
           each.value.title)
        div(class=rows,
          each.value.links.enumerate().map(item =>
            tile(item.value, each.index, item.index)))
      )))
}

toolbar() -> Element[] {
  if locked {
    return []
  }

  layout = if config.layout == Grid {
    "Grid"
  } else {
    "Vertical"
  }

  [div(class="toolbar"
    button(class="btn btn-sm btn-primary", onclick=open_new, "Add link")
    button(class="btn btn-sm", onclick=toggle_layout, layout)
    button(class="btn btn-sm", onclick=sort_links, "Sort A-Z")
    button(class="btn btn-sm", onclick=export_json, "Export")
    button(class="btn btn-sm", onclick=import_json, "Import")
    button(class="btn btn-sm btn-ghost", onclick=reset_config, "Reload config file")
    span(class="text-xs opacity-50", note)
  )]
}

open_new() {
  edit = Editing(Fresh)
  form = blank()
  form_section = ""
}

open_at(section: int, index: int) {
  if locked {
    return
  }

  edit = Editing(Existing(section, index))
  form = config.sections[section].links[index]
  form_section = config.sections[section].title
}

close() {
  edit = Closed
}

save() {
  link = Link {
    title = form.title.trim(),
    url = form.url.trim(),
    icon = form.icon.trim()
  }

  if link.title == "" || link.url == "" {
    note = "title and url are required"

    return
  }

  name = form_section.trim()

  if name == "" {
    name = "Links"
  }

  match edit {
    Closed => return
    Editing(target) => commit(saved(target, name, link), "saved {link.title}")
  }

  close()
}

saved(target: Target, name: str, link: Link) -> Config =>
  match target {
    Fresh => insert_link(config, name, link, End)
    Existing(section, index) => insert_link(remove_link(config, section, index),
                                            name, link, kept(section, index, name))
  }

kept(section: int, index: int, name: str) -> Where {
  if config.sections[section].title == name {
    return At(index)
  }

  End
}

erase() {
  match edit {
    Closed => return
    Editing(Fresh) => return
    Editing(Existing(section, index)) => {
      gone = config.sections[section].links[index].title
      commit(remove_link(config, section, index), "deleted {gone}")
    }
  }

  close()
}

delete_button() -> Element[] {
  match edit {
    Editing(Existing(_, _)) =>
      [button(class="btn btn-sm btn-error btn-outline", onclick=erase, "Delete")]
    Closed => []
    Editing(Fresh) => []
  }
}

dialog() -> Element[] =>
  match edit {
    Closed => []
    Editing(_) => [dialog_box()]
  }

dialog_box() -> Element =>
  div(class="modal modal-open"
    div(class="modal-box glass flex flex-col gap-3"
      h3(class="font-bold text-lg", "Link")
      input(class="input input-bordered w-full", placeholder="Title",
            value=form.title)
      input(class="input input-bordered w-full", placeholder="https://…",
            value=form.url)
      div(class="flex items-center gap-2"
        input(class="input input-bordered flex-1", placeholder="lucide:link",
              value=form.icon)
        span(class="w-10 flex items-center justify-center",
          iconify-icon(class="text-2xl", icon=form.icon))
      )
      input(class="input input-bordered w-full", placeholder="Section",
            value=form_section)
      div(class="modal-action"
        delete_button()
        div(class="flex-1")
        button(class="btn btn-sm btn-ghost", onclick=close, "Cancel")
        button(class="btn btn-sm btn-primary", onclick=save, "Save")
      )
    )
  )
